# syntax=docker/dockerfile:1
# imageCLI generation worker — NATS satellite serving lyra.image.generate.request.
#
# ── build stage ──────────────────────────────────────────────────────────────
ARG ML_BASE_TAG=cu130-staging
FROM ghcr.io/roxabi/ml-base:${ML_BASE_TAG} AS builder

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# Build deps: ml-base supplies python3.12 + uv + torch/torchvision but no C toolchain.
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ python3-dev \
        git ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN uv venv --system-site-packages /app/.venv

# Packages already present in ml-base's system site-packages — skip to avoid
# duplicating ~GB of NVIDIA CUDA libs and triton in the venv.
RUN UV_SKIP="--no-install-package torch \
    --no-install-package torchvision \
    --no-install-package triton \
    --no-install-package cuda-bindings \
    --no-install-package cuda-toolkit \
    --no-install-package nvidia-cublas \
    --no-install-package nvidia-cuda-cupti \
    --no-install-package nvidia-cuda-nvrtc \
    --no-install-package nvidia-cuda-runtime \
    --no-install-package nvidia-cudnn-cu13 \
    --no-install-package nvidia-cufft \
    --no-install-package nvidia-cufile \
    --no-install-package nvidia-curand \
    --no-install-package nvidia-cusolver \
    --no-install-package nvidia-cusparse \
    --no-install-package nvidia-cusparselt-cu13 \
    --no-install-package nvidia-nccl-cu13 \
    --no-install-package nvidia-nvjitlink \
    --no-install-package nvidia-nvshmem-cu13 \
    --no-install-package nvidia-nvtx" && \
    echo "$UV_SKIP" > /uv-skip-flags

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project $(cat /uv-skip-flags)

COPY src/ ./src/
RUN uv sync --frozen --no-dev $(cat /uv-skip-flags)

# ── runtime stage ─────────────────────────────────────────────────────────────
FROM ghcr.io/roxabi/ml-base:${ML_BASE_TAG} AS runtime

LABEL org.opencontainers.image.source="https://github.com/Roxabi/imageCLI" \
      org.opencontainers.image.description="imageCLI NATS satellite — FLUX/SD3.5 on cu130" \
      org.opencontainers.image.licenses="MIT"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN groupadd -r -g 1503 imagecli && \
    useradd -r -u 1503 -g imagecli -m -d /home/imagecli -s /bin/bash imagecli

COPY --from=builder --chown=imagecli:imagecli /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    VIRTUAL_ENV="/app/.venv" \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
USER imagecli

CMD ["sh", "-c", "exec imagecli nats-serve image --engine \"${IMAGECLI_ENGINE:-flux2-klein}\""]